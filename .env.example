# Who can use Sage. Make these with: npm run make-codes -- alex sam jordan
ACCESS_CODES=alex:abcd-efgh-jkmn

# The AI model. Download it first with: ollama pull qwen2.5:7b
AI_MODEL=qwen2.5:7b

# Where the AI runs. This is Ollama's default address; leave it alone unless
# you use LM Studio (http://localhost:1234/v1) or another server.
AI_BASE_URL=http://localhost:11434/v1

# Only needed if AI_BASE_URL points at a paid cloud service.
# AI_API_KEY=

# How many messages each friend can send per day.
DAILY_MESSAGES_PER_FRIEND=150

PORT=3000
