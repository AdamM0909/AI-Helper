{
  "name": "Sage tutor",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "npm install",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Sage", "onAutoForward": "openBrowser" }
  },
  "secrets": {
    "ANTHROPIC_API_KEY": { "description": "Your Anthropic API key from console.anthropic.com" },
    "ACCESS_CODES": { "description": "Access codes from `npm run make-codes`" }
  }
}
